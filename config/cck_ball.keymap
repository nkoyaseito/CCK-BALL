#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp TAB           &kp Q  &kp W         &kp E      &kp R        &kp T       &kp Y      &kp U        &kp I      &kp O      &kp P          &kp BACKSPACE
&kp CAPSLOCK      &kp A  &kp S         &kp D      &kp F        &kp G       &kp H      &kp J        &kp K      &kp L      &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT    &kp Z  &kp X         &kp C      &kp V        &kp B       &kp N      &kp M        &kp COMMA  &kp DOT    &kp SLASH      &kp LG(LS(S))
&kp LEFT_CONTROL  &mo 2  &kp LEFT_ALT  &kp SPACE  &lt 1 SPACE  &kp DELETE  &mkp LCLK  &lt 1 SPACE  &kp ENTER  &mkp RCLK  &mkp MB2       &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layers {
            bindings = <
&trans     &kp F1   &kp F2                &kp F3                 &kp F4            &kp F5             &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0          &kp ASTERISK   &kp SQT
&kp GRAVE  &kp F6   &kp F7                &kp F8                 &kp F9            &kp F10            &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS             &kp SLASH      &kp PERIOD
&kp CAPS   &kp F11  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS              &kp COLON      &kp ENTER
&trans     &trans   &trans                &trans                 &trans            &trans             &mkp LCLK     &mkp RCLK     &kp ENTER     &kp NON_US_BACKSLASH  &kp SEMICOLON  &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        symbo_layers {
            bindings = <
&none      &kp EXCL  &kp AT    &kp HASH      &kp DOLLAR  &kp PERCENT  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)    &kp LS(LPAR)  &kp LS(RPAR)  &kp BACKSPACE
&kp TILDE  &kp LBRC  &kp RBRC  &kp QUESTION  &none       &none        &none          &kp UNDER     &kp PLUS        &kp COLON     &kp DQT       &kp DELETE
&none      &none     &none     &none         &none       &kp TILDE    &kp UNDER      &kp PLUS      &kp LEFT_BRACE  &kp RBRC      &kp UP_ARROW  &none
&none      &none     &none     &none         &mo 3       &none        &none          &none         &none           &kp LEFT      &kp DOWN      &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        settings-layers {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans     &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL  &trans     &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &mkp MCLK       &trans     &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &mkp RCLK       &kp LCTRL  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        snipe-layers {
            bindings = <
&none   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6     &kp F7     &kp F8  &kp F9    &kp F10    &kp DEL
&trans  &none   &none   &none   &none   &none   &none      &kp LEFT   &kp UP  &kp DOWN  &kp RIGHT  &kp BSPC
&trans  &none   &none   &none   &none   &none   &mkp MCLK  &none      &trans  &trans    &trans     &trans
&none   &none   &none   &none   &trans  &none   &mkp LCLK  &mkp RCLK  &trans  &trans    &trans     &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };
    };
};
